# SecureCopilot365 Root Environment Variables Example

# Test Mode
TEST_MODE=true

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://mock-openai.azure.com/
AZURE_OPENAI_KEY=mock_openai_key_placeholder
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Microsoft Entra ID & Graph API
ENTRA_TENANT_ID=mock-tenant-id
ENTRA_CLIENT_ID=mock-client-id
ENTRA_CLIENT_SECRET=mock-client-secret
GRAPH_CLIENT_ID=mock-graph-client-id
GRAPH_CLIENT_SECRET=mock-graph-client-secret
MICROSOFT_GRAPH_ACCESS_TOKEN=mock_graph_access_token_12345

# Database URL (SQLite default for local execution)
DATABASE_URL=sqlite:///./securecop365.db

# JWT Configuration
APP_SECRET_KEY=supersecretkeyatleast32characterslongforsecurity
JWT_SECRET=supersecretkeyatleast32characterslongforsecurity
