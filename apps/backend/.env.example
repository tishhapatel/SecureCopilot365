# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Microsoft Entra ID (Authentication)
ENTRA_TENANT_ID=your_tenant_id
ENTRA_CLIENT_ID=your_client_id
ENTRA_CLIENT_SECRET=your_client_secret
ENTRA_AUTHORITY=https://login.microsoftonline.com/YOUR_TENANT_ID

# Microsoft Graph API
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0

# Azure SQL Database
DATABASE_URL=mssql+pyodbc://USER:PASS@SERVER.database.windows.net/securecop365?driver=ODBC+Driver+18+for+SQL+Server

# Azure AI Search (Foundry IQ vector store)
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AZURE_SEARCH_API_KEY=your_search_key
AZURE_SEARCH_INDEX_NAME=securecop365-knowledge

# Azure Key Vault
KEY_VAULT_URL=https://YOUR_KEYVAULT.vault.azure.net/

# Teams Bot
BOT_ID=your_bot_id
BOT_PASSWORD=your_bot_password
BOT_TENANT_ID=your_tenant_id

# Application
APP_ENV=development
APP_SECRET_KEY=your_secret_key_min_32_chars
CORS_ORIGINS=http://localhost:5173,https://your-frontend-url.azurecontainerapp.io
